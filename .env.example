# Copy this file to .env.onboard (gitignored) and fill in real values.
# scripts/onboard.mjs auto-loads it so you don't have to `source` it
# yourself. Never commit .env.onboard.

# --- Monzo (confidential OAuth client from developers.monzo.com) ---
MONZO_CLIENT_ID=oauth2client_...
MONZO_CLIENT_SECRET=mnzconf....
MONZO_REDIRECT_URI=http://localhost:3000/callback

# --- TrueLayer (Console app at console.truelayer.com) ---
TL_ENV=sandbox
# TL_ENV=live
TRUELAYER_CLIENT_ID=sandbox-...
TRUELAYER_CLIENT_SECRET=...
TRUELAYER_REDIRECT_URI=https://console.truelayer.com/redirect-page
